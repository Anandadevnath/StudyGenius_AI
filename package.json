{
  "name": "studygenius-ai",
  "version": "0.1.0",
  "private": true,
  "description": "StudyGenius AI - Personal Learning Assistant (CSE 464). Monorepo foundation: Expo mobile app + Node/Express AI backend.",
  "workspaces": [
    "apps/mobile",
    "apps/backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n mobile,backend -c cyan,magenta \"npm:dev:mobile\" \"npm:dev:backend\"",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "dev:backend": "npm run dev --workspace apps/backend",
    "mobile": "npm run dev:mobile",
    "backend": "npm run dev:backend",
    "lint": "npm run lint --workspace apps/mobile && npm run lint --workspace apps/backend",
    "lint:mobile": "npm run lint --workspace apps/mobile",
    "lint:backend": "npm run lint --workspace apps/backend",
    "test": "npm run test --workspace apps/mobile && npm run test --workspace apps/backend",
    "test:mobile": "npm run test --workspace apps/mobile",
    "test:backend": "npm run test --workspace apps/backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}

rules_version = '2';

// StudyGenius AI — Cloud Storage security rules (proposal §10.3, §14).
// Owner: Ananda. Files live under notes/{uid}/...; only the signed-in owner can
// read or write their own files. Size and content-type limits mirror the client
// validation in apps/mobile/src/services/firebase/fileValidation.js.
// Applied manually in the console (Storage -> Rules) or via
// `firebase deploy --only storage`.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 10 MB max, matching MAX_FILE_SIZE_BYTES on the client.
    function withinSizeLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // Allowed content types (PDF, DOCX, TXT, JPG, PNG).
    function allowedType() {
      return request.resource.contentType.matches(
        'application/pdf|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|text/plain|image/jpeg|image/png'
      );
    }

    // notes/{uid}/{fileName}
    match /notes/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && withinSizeLimit() && allowedType();
      allow delete: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

# =============================================================================
# StudyGenius AI — MOBILE environment variables  (apps/mobile/.env)
# =============================================================================
# Combined reference for BOTH team members.
#
# Copy this file to `apps/mobile/.env` and fill in real values:
#     cp apps/mobile/.env.example apps/mobile/.env
# `apps/mobile/.env` is git-ignored and must NEVER be committed.
#
# SECURITY — READ THIS
# --------------------
# Every EXPO_PUBLIC_* variable is EMBEDDED INTO THE MOBILE BUNDLE and is PUBLIC.
# Anyone who installs the app can read them.
#   ✔ Safe here : Firebase client config, public backend URL.
#   ✘ NEVER here: Gemini API key, Firebase Admin/service-account credentials.
#                 Those live ONLY in apps/backend/.env (server-side, private).
#
# Owner map (proposal §16 work division):
#   Ananda — Firebase client/auth, Storage, offline cache, API client.
#   Rafshia — screens read these through the services/stores; no new secrets.
# =============================================================================

# --- Firebase client configuration (PUBLIC) — Ananda -------------------------
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# --- Secure AI backend base URL (PUBLIC) — shared ----------------------------
# Ananda runs the Express backend; Rafshia's screens call summary/quiz/plan
# through this URL. Required for the AI workflow to reach the backend.
#   • Web / iOS Simulator : http://localhost:4000
#   • Android emulator    : http://10.0.2.2:4000
#   • Physical device     : http://<your-machine-LAN-IP>:4000  (same Wi-Fi)
# Do NOT include a trailing slash.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

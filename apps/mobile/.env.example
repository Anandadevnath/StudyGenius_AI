# Skip if you are not using these integrations yet; they are documented as
# PLACEHOLDERS for later feature development.
#
# SECURITY WARNING
# ---------------
# Every variable prefixed with EXPO_PUBLIC_ is embedded into the mobile app
# bundle and is PUBLIC. Never put the Gemini API key, a Firebase Admin private
# key, or any service-account credential in this file. Those belong ONLY in
# backend/.env (which is git-ignored).
#
# Copy this file to `mobile/.env` and fill in the values from your Firebase
# project settings (Project settings -> General -> Your apps -> SDK setup).
# `mobile/.env` is git-ignored and must never be committed.

# --- Firebase client configuration (public) ---
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# --- Secure AI backend base URL (public) ---
# For a physical device on a LAN, use the host machine's LAN IP, not localhost.
# Example: http://192.168.1.50:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

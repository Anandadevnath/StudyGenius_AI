# Private (server-side only). Copy to apps/backend/.env. NEVER expose to the client.
PORT=4000
NODE_ENV=development

GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.5-flash

FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to a service-account JSON kept OUTSIDE the repo (preferred).
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative: application-default credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated origins. Empty = allow all (dev only).
ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=debug

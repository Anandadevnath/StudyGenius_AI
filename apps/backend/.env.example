# StudyGenius AI — backend environment variables
#
# Copy this file to `backend/.env` and fill in real values.
# `backend/.env` is git-ignored and must NEVER be committed.
#
# SECURITY: This file holds PRIVATE server-side secrets. Nothing here may be
# copied into the mobile app or into any EXPO_PUBLIC_* variable (proposal §14).

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Google Gemini (PRIVATE — backend only) ---
# Obtain from Google AI Studio. Never expose to the client.
# Proposal §7 / §12.4: the exact model is chosen at backend implementation time.
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Admin (PRIVATE — backend only) ---
# The Admin SDK verifies Firebase ID tokens (proposal §8, §10.3).
# Provide credentials via a service-account JSON kept OUTSIDE the repository.
# Do NOT commit service-account files. Do NOT create fake credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Preferred: absolute path to a service-account JSON outside the repo.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative: application-default credentials path.
GOOGLE_APPLICATION_CREDENTIALS=

# --- CORS ---
# Comma-separated list of allowed client origins. Empty = allow all (dev only).
ALLOWED_ORIGINS=

# --- Rate limiting (proposal §8, §14) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=debug

# =============================================================================
# StudyGenius AI — BACKEND environment variables  (apps/backend/.env)
# =============================================================================
# Private, server-side only. Owner: Ananda (proposal §16).
#
# Copy this file to `apps/backend/.env` and fill in real values:
#     cp apps/backend/.env.example apps/backend/.env
# `apps/backend/.env` is git-ignored and must NEVER be committed.
#
# SECURITY (proposal §14)
# -----------------------
# This file holds PRIVATE secrets. Nothing here may be copied into the mobile
# app or into any EXPO_PUBLIC_* variable. Never commit service-account JSON,
# keystores, or real keys.
# =============================================================================

# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Google Gemini (PRIVATE — backend only) -----------------------------------
# Obtain from Google AI Studio. Never exposed to the client.
# Model name is illustrative until the backend is built (proposal §12.4).
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Admin (PRIVATE — backend only) ----------------------------------
# The Admin SDK verifies Firebase ID tokens (proposal §8, §10.3).
# Provide credentials via a service-account JSON kept OUTSIDE the repository.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Preferred: absolute path to a service-account JSON outside the repo.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative: application-default credentials path.
GOOGLE_APPLICATION_CREDENTIALS=

# --- CORS ----------------------------------------------------------------------
# Comma-separated allowed client origins. Empty = allow all (dev only).
ALLOWED_ORIGINS=

# --- Rate limiting (proposal §8, §14) -----------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=debug

rules_version = '2';

// StudyGenius AI — Firestore security rules (proposal §10.3, §14).
// Owner: Ananda. Every document carries ownerUid; reads/writes require the
// signed-in user to own the document. Applied manually in the Firebase console
// (Firestore Database -> Rules) or via `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the caller owns the existing document (reads, updates, deletes).
    function ownsExisting() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // True when the incoming document is tagged with the caller's own uid
    // (creates, and updates that must not change ownership).
    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // users/{uid} — the profile document is keyed by uid.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false; // profiles are not client-deletable
    }

    // Each remaining collection is user-owned via the ownerUid field.
    match /notes/{noteId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /summaries/{summaryId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /quizzes/{quizId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /quizAttempts/{attemptId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /studyPlans/{planId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /reminders/{reminderId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
